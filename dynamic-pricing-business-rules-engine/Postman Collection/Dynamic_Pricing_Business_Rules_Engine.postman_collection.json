            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Customer Discount\",\n  \"description\": \"10 percent premium discount\",\n  \"priority\": 10,\n  \"execution_type\": \"COMBINABLE\",\n  \"maximum_discount\": 5000,\n  \"start_date\": \"2026-01-01T00:00:00\",\n  \"end_date\": \"2026-12-31T23:59:59\",\n  \"is_active\": true,\n  \"conditions\": [\n    {\n      \"field\": \"customer_type\",\n      \"operator\": \"=\",\n      \"value\": \"PREMIUM\",\n      \"condition_group\": 1,\n      \"logical_operator\": \"AND\"\n    }\n  ],\n  \"actions\": [\n    {\n      \"action_type\": \"DISCOUNT\",\n      \"discount_type\": \"PERCENTAGE\",\n      \"value\": 10\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "List Pricing Rules",
          "request": {
            "method": "GET",
            "header": [
              {
